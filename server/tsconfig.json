{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": [],
    "strict": false,
    "noEmit": true
  },
  "include": ["./**/*.ts", "../shared/**/*.ts", "../api/**/*.ts"]
}
