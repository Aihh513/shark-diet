# 数据库连接串（Neon / Vercel Postgres / Supabase 等 PostgreSQL）
# 免费 Neon：https://neon.tech  注册后复制 Connection String
DATABASE_URL=

# USDA FoodData Central API Key（免费注册）
# https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=

# 以下可选，默认值已内置

# 应用运行环境
NODE_ENV=production

# 免费额度控制：营养搜索每分钟最多请求数
RATE_LIMIT_PER_MIN=30
